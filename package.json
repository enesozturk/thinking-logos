{
  "name": "thinking-logo",
  "version": "0.1.0",
  "description": "Turn your logo into a dotted thinking orb \u2014 bake any SVG into a 3D point cloud and animate it as an AI/agent loading state",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./engine": {
      "import": {
        "types": "./dist/engine/index.d.ts",
        "default": "./dist/engine.es.js"
      },
      "require": {
        "types": "./dist/engine/index.d.ts",
        "default": "./dist/engine.cjs"
      }
    },
    "./bake": {
      "import": {
        "types": "./dist/bake/index.d.ts",
        "default": "./dist/bake.es.js"
      },
      "require": {
        "types": "./dist/bake/index.d.ts",
        "default": "./dist/bake.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.config.demo.ts",
    "build": "vite build",
    "build:demo": "vite build --config vite.config.demo.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:demo": "tsc --noEmit -p tsconfig.demo.json",
    "spec": "tsx scripts/extract-spec.ts && tsx scripts/extract-golden.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shadcn": "^4.18.0",
    "simple-icons": "^16.28.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0"
  },
  "keywords": [
    "react",
    "loading",
    "loader",
    "spinner",
    "ai",
    "agent",
    "llm",
    "canvas",
    "animation",
    "logo",
    "branding",
    "svg",
    "point-cloud",
    "dark-mode"
  ],
  "author": "Enes Ozturk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enesozturk/thinking-logo.git"
  },
  "bugs": {
    "url": "https://github.com/enesozturk/thinking-logo/issues"
  },
  "homepage": "https://github.com/enesozturk/thinking-logo",
  "contributors": [
    "Jakub Antalik (thinking-orbs, the engine this is built on)"
  ]
}
