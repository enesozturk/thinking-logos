{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Stays singular even though the repo and the site are "thinking-logos".
  // This is the deployed Worker's identity: renaming it would create a
  // second, empty Worker and leave the custom domain and route bound to
  // the old one.
  "name": "thinking-logo",
  // Assets only — there is no `main`, so no Worker code runs and nothing is
  // billed per request. The whole demo is static files.
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./dist-demo",
    // The /{company} routes have no file behind them. Assets are matched
    // first, so real files — the hashed bundles, filmstrip.html — still win,
    // and only unmatched paths fall through to the app's own router.
    //
    // Needs a compatibility date of 2025-04-01 or later, which is what makes
    // navigation requests skip Worker invocation entirely.
    "not_found_handling": "single-page-application"
  },
  // Two entries for one hostname, deliberately.
  //
  // The custom domain is what binds the Worker and provisions its
  // certificate. On its own it was not enough: the zone carries a
  // wildcard `*.ozturkenes.com` A record left over from the Vercel
  // migration, and Cloudflare had created only the AAAA half of the
  // custom domain's record pair — so IPv4 traffic for this hostname fell
  // through to the wildcard and was answered by Vercel with a 404. The
  // missing A record cannot be added by hand ("a DNS record managed by
  // Workers already exists on that host"), so the route is what closes
  // the gap: it matches the hostname regardless of which origin DNS
  // resolves to.
  "routes": [
    { "pattern": "thinking-logos.ozturkenes.com", "custom_domain": true },
    { "pattern": "thinking-logos.ozturkenes.com/*", "zone_name": "ozturkenes.com" }
  ]
}
